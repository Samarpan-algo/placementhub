# Copy to frontend/.env.local if you need to change it (git-ignored). Vite only exposes VITE_* variables.
# Empty (the default): requests go to /api on the same origin, and the Vite dev proxy forwards them
# to http://localhost:8080. In Milestone 12 set it to the deployed backend, e.g. https://placementhub-api.onrender.com
VITE_API_BASE_URL=
