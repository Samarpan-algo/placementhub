# Copy this file to .env (never commit .env).
# Docker Compose reads .env; Spring Boot does NOT.
# KEEP IN SYNC: these values must match the defaults in
# backend/src/main/resources/application.yml (DB name, user, password, port).

POSTGRES_DB=placementhub
POSTGRES_USER=placementhub
POSTGRES_PASSWORD=placementhub_dev
POSTGRES_PORT=5432

# --- Backend (read from the environment by Spring Boot, not from this file) ---
# JWT signing secret, at least 32 bytes (256 bits). Generate one with: openssl rand -base64 48
# If unset, the backend uses a DEV-ONLY default and logs a WARNING. Production MUST set a real value.
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes
