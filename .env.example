# Copy this file to .env (never commit .env).
# Docker Compose reads this file, and the backend imports it too (spring.config.import in application.yml).
# Real environment variables win over it, which is how production works (see docs/deploy.md).
# KEEP IN SYNC: these values must match the defaults in
# backend/src/main/resources/application.yml (DB name, user, password, port).

POSTGRES_DB=placementhub
POSTGRES_USER=placementhub
POSTGRES_PASSWORD=placementhub_dev
POSTGRES_PORT=5432

# --- Backend ---
# JWT signing secret, at least 32 bytes (256 bits). Generate one with: openssl rand -base64 48
# If unset, the backend uses a DEV-ONLY default and logs a WARNING. Production MUST set a real value.
# Commented out so that copying this file can't silently sign tokens with a publicly known value.
# JWT_SECRET=

# Browser origins allowed to call the API (comma-separated, no trailing slash). Default: http://localhost:5173
# Local dev uses the Vite proxy, so this matters once the frontend is deployed (Milestone 12).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Resume storage: a PRIVATE Supabase Storage bucket. Leave empty and resume endpoints answer 503.
# The secret key is backend-only: never put it in the frontend, in logs or in Git.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_RESUME_BUCKET=resumes
